# One-off debug tooling output at repo root (PDF/glyph extraction)
/__pycache__/
**/__pycache__/
/_*.py
/_*.txt
/_*.log
/_*.png
/_*.ttf
/_*.bin
/_*.ps1
/pip.done
/piperr.txt
/pipout.txt

# Credentials & env — never commit, anywhere (mobile/.gitignore has the
# in-app copies too; these patterns are the root-level safety net).
**/.env
**/.env.*
# The template is the opposite of a secret, and `**/.env.*` above swallows it
# as collateral. It is the only place a fresh clone can learn that
# `EXPO_PUBLIC_FIREBASE_DATABASE_URL` exists at all, and that its value is a
# REGIONAL HOST — `https://<db>.<region>.firebasedatabase.app` — rather than
# the `<project>-default-rtdb.firebaseio.com` that still looks authoritative
# and answers 404 with an empty body. Keeping it ignored left that only in a
# local file nobody else had.
!.env.example
**/service-account*.json

# Dependencies & build output
**/node_modules/
**/.expo/ocr_pages/ocr_text/ocr_cells/

data/*
/data/*/**


# Roll-extraction debug output — regenerable by tools/extract_roll scripts,
# never committed (ocr_cells alone is ~439MB of per-cell PNGs).
/tools/extract_roll/ocr_cells/
/tools/extract_roll/*.log
/bad6.txt
/bad_houses.txt
/nonnum*.txt
/r.json
/info.json
