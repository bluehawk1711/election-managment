rules_version = '2';

// The real access control for this app.
//
// Your Firebase config ships inside the app bundle, so these rules — not the
// client code — are what stands between a user and the data. The route guards
// in app/_layout.tsx are a convenience; this file is the boundary.
//
// Model: ONE shared campaign, plus a **read-only imported roll**.
//
// Three access tiers, defined in plan-voters.md §5 and mirrored by
// `lib/roles.ts` on the client:
//
//   karykarta    reads the roll of their assigned ward only
//   admin        reads every ward, manages campaign content
//   superAdmin   everything admin can, plus assigns roles and wards
//   developer    everything superAdmin can (this prototype's escape hatch)
//
// A user with **no role** has no capabilities at all. That is deliberate: a
// freshly created account is inert rather than privileged, and a super admin
// has to grant access explicitly. `lib/roles.ts` says the same thing and the
// rules tests assert it.
//
// Three design rules worth stating out loud:
//
// 1. **The base roll is read-only from the client.** `voters` and the roll
//    `wards` are imported data — byte-identical to the CSVs `EXTRACTION.md`
//    documents, seeded by `scripts/seed-roll.mjs` with the Admin SDK. No
//    client, patched or otherwise, can create, update or delete a roll row.
//    Everything a user adds (photo, location, corrections, voted, leaning)
//    lives in the **overlay**, which today is local-only AsyncStorage
//    (`lib/roll/overlay.ts`) and syncs later.
//
// 2. **No political profiling, ever.** `noPoliticalFields` rejects `party`,
//    `preference`, `votedFor` and friends on every collection a client may
//    write. The blueprint's product boundary is enforced here, not in the UI.
//    On the roll this is belt-and-braces — clients cannot write there at all —
//    but it also guards the collections that do accept writes, so a future
//    change that opens the roll up cannot silently open profiling with it.
//
// 3. **Exact key sets.** `hasOnly + hasAll` means an unknown field is a
//    rejected write rather than silently stored data nobody validates — and
//    it keeps `orderBy` fields present on every document (Firestore drops
//    documents missing an ordered field, so a typo would make rows vanish).
//
// Timestamps: `createdAt`/`reportedAt` are written with `serverTimestamp()`,
// which the rules language evaluates as `request.time` — a client clock can't
// backdate them. Date fields (dueDate, event startsAt, expense date) are
// client-side epoch millis on purpose: they are business dates, not audit
// stamps.
//
// Run these: `npm run rules:test`.

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- identity -------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * The caller's `users/{uid}` document, or `null` when there is none.
     *
     * The `exists()` guard in every caller is load-bearing, for two reasons
     * that both surface as an opaque `PERMISSION_DENIED: evaluation error`
     * rather than a readable denial:
     *
     * 1. `get()` on a missing document is an *error*, not `false`. A signed-in
     *    user with no profile yet — everyone between sign-up and their first
     *    snapshot — would otherwise get an unreadable failure instead of "you
     *    have no role".
     * 2. **Firestore evaluates `update` rules during a `create`.** `&&` does
     *    not short-circuit there, so a role check on the `update` path runs even
     *    when the write is a profile creation, and errors if the caller's
     *    document does not exist yet. `rules-tests/` pins this down: a plain
     *    sign-up `create` and the role-grant `update` rule live on the same
     *    path and must both succeed.
     *
     * Verified empirically against the emulator, not assumed — the reasoning
     * above is wrong in at least one place otherwise.
     *
     * Every helper needs a capability goes through here. Rules have no caching
     * for `get()` — a `list` re-evaluates the rule for each returned document,
     * so reading a ward of 800 voters performs 800 profile reads. That is the
     * price of storing roles in a document instead of custom claims (a claim
     * cannot be revoked without a token refresh, which is why it is the wrong
     * tool for a role an admin can take away). The practical fix is what the
     * per-ward `where` queries in `firestore-source.ts` already do: never ask
     * for more than one ward.
     */
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    /**
     * `true` when the caller may read voter data at all.
     *
     * `exists()` rather than a field read, so a missing document or an
     * unparseable one denies by default instead of erroring the whole query.
     */
    function canReadVoters() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && callerProfile().data.role in
                  ['karykarta', 'admin', 'superAdmin', 'developer'];
    }

    /** Roles that see the whole roll, not one ward. */
    function canSeeAllWards() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && callerProfile().data.role in ['admin', 'superAdmin', 'developer'];
    }

    /**
     * `true` when the caller may read this specific roll row.
     *
     * Written against `resource.data`, so Firestore evaluates it per returned
     * document rather than against the query. That has a consequence worth
     * being explicit about, because it is the opposite of the intuitive
     * reading:
     *
     * A karykarta asking for the WHOLE collection does not get an empty result,
     * it gets a permission error — the rule rejects every row outside their
     * ward, and one rejected row fails the whole query. That is the safe
     * direction to fail in, and it is why `lib/roll/firestore-source.ts` always
     * pairs `wardNo == null` with a role that `visibleWards` says is
     * unrestricted.
     */
    function canReadVoter(data) {
      return canReadVoters()
             && (canSeeAllWards()
                 || (callerProfile().data.role == 'karykarta'
                     && callerProfile().data.wardNo == data.wardNo));
    }

    // ----- schema helpers -------------------------------------------------

    function exactKeys(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function nullableMillis(value) {
      return value == null || value is int || value is float;
    }

    function requiredMillis(value) {
      return value is int || value is float;
    }

    /**
     * The product boundary, server-side.
     *
     * A denylist rather than an allowlist because the collections a client may
     * write differ from each other and already have exact key sets on their own
     * rules — this is the one check that applies everywhere, including to any
     * collection added later, which is exactly the moment an allowlist here
     * would be forgotten to extend.
     */
    function noPoliticalFields(data) {
      return !data.keys().hasAny(
        ['party', 'partyAffiliation', 'preference', 'votedFor', 'support', 'voteChoice']
      );
    }

    /** Campaign-content write: any role that can read voters may edit. */
    function canEditCampaign() {
      return canReadVoters();
    }

    /** Accounts, roles and ward assignment — `accountManage` in lib/roles.ts. */
    function canManageAccounts() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && callerProfile().data.role in ['superAdmin', 'developer'];
    }

    /**
     * Roster visibility — `accountView` in lib/roles.ts.
     *
     * Everything a super admin creates has to be *visible* to the people below
     * them: an admin opens More → Accounts and sees who is on the team. So the
     * `list` below reads through this helper, widened to `admin` — while every
     * write path (create, role grant, delete) keeps `canManageAccounts`.
     *
     * Deliberately still one-way: a `get` of someone else's document stays
     * owner-only, and a karykarta cannot list either. Widening *visibility* to
     * admin must not widen write access by a single field — the two helpers
     * exist separately so the one cannot drift into the other.
     *
     * Superset: every role in `canManageAccounts` is in this list, so a caller
     * that may manage accounts can always list them too.
     */
    function canViewAccounts() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && callerProfile().data.role in ['admin', 'superAdmin', 'developer'];
    }

    // ----- profile --------------------------------------------------------

    match /users/{userId} {
      // The document id IS the uid, which is what lets this be checked without
      // reading the document first.
      allow get: if isOwner(userId);

      // Listing is an account-management capability, not a self-service one:
      // it exposes every user's email and role. Super admins and developers
      // manage it; admins may READ the roster (they work with the team a super
      // admin created) but every write path below still requires
      // `canManageAccounts`. Karykarta and roleless accounts get neither —
      // `more/users` runs against this rule.
      allow list: if canViewAccounts();

      // `onboarded == false` on create means a client cannot sign up already
      // onboarded and skip the flow.
      //
      // `role` and `wardNo` are absent from this allow-list on purpose: a
      // client must not be able to create itself as an admin. Roles are granted
      // by an existing super admin through the `update` rule below.
      allow create: if isOwner(userId)
                    && request.resource.data.onboarded == false
                    && request.resource.data.keys().hasOnly(
                         ['email', 'displayName', 'photoURL', 'onboarded', 'createdAt', 'updatedAt']);

      // A super admin creating someone ELSE's account (More → Accounts → New).
      //
      // `userId != request.auth.uid` again: signing up must never be a route to
      // a role, so the self-create path above stays role-free and this one only
      // ever writes somebody else's document.
      //
      // `onboarded == true` because this is the one path that SKIPS onboarding
      // — the admin is setting the account up, not the account owner, and the
      // owner never sees the onboarding flow at all. Combined with a mandatory
      // `role` (checked below, and the field is required by the exact key set),
      // that means every account made here is usable immediately: there is no
      // "created but not yet configured" state to get stuck in.
      allow create: if canManageAccounts()
                    && userId != request.auth.uid
                    && request.resource.data.onboarded == true
                    && request.resource.data.keys().hasOnly(
                         ['email', 'displayName', 'photoURL', 'onboarded',
                          'role', 'wardNo', 'createdAt', 'updatedAt'])
                    && request.resource.data.role in
                         ['karykarta', 'admin', 'superAdmin', 'developer']
                    // Email sanity: 3–320 chars. `.get()` rather than a direct
                    // field read because rules `&&` does not short-circuit —
                    // an absent `email` on the other side of an operator would
                    // be an evaluation error, not a denial. (The previous
                    // `text(data.email, 3, 320)` here was not a valid rules
                    // call at all — `text()` takes one argument — which made
                    // EVERY admin-created account fail evaluation, karykarta
                    // first and loudest because that is the form's default
                    // role.)
                    && request.resource.data.get('email', '') is string
                    && request.resource.data.get('email', '').size() >= 3
                    && request.resource.data.get('email', '').size() <= 320
                    // A karykarta must be ward-scoped and nothing else may be:
                    // an admin with a `wardNo` looks restricted in the UI
                    // (`visibleWards` ignores it for every role but karykarta)
                    // while the rules disagree, and the two disagreeing is how
                    // "why can this user see ward 9" tickets get filed.
                    && ((request.resource.data.role == 'karykarta'
                         && request.resource.data.wardNo is int
                         && request.resource.data.wardNo > 0)
                        || (request.resource.data.role != 'karykarta'
                            && !request.resource.data.keys().hasAny(['wardNo'])))
                    && noPoliticalFields(request.resource.data);

      // Self-service update: the profile fields and nothing else. `email` is
      // absent on purpose — it mirrors the Firebase Auth record.
      allow update: if isOwner(userId)
                    && resource != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'photoURL', 'onboarded', 'updatedAt']);

      // Granting or changing a role is a separate, explicit path — otherwise
      // "update your display name" and "promote yourself to superAdmin" would be
      // the same rule, and the only thing between them is remembering which
      // fields you sent.
      //
      // `resource != null` is load-bearing: `resource` is null on a create, the
      // emulator evaluates this clause during a create too, and an unguarded
      // `resource.data` read there is an evaluation error rather than a clean
      // `false`.
      //
      // The two validation blocks below are written defensively, and both
      // defensivenesses are load-bearing. Three separate ways to write this
      // rule "correctly" produce a runtime error instead of a denial, each
      // surfacing as an opaque `PERMISSION_DENIED: evaluation error` on writes
      // that are otherwise perfectly valid:
      //
      //   - `hasAny(['role']) == (role in [...])` — `==` binds looser than `in`
      //     here, so it parses as `(bool == role) in [...]`, a list `in` a bool.
      //   - `request.resource.data.role == resource.data.role` — when the field
      //     is absent, `resource.data.role` is *undefined*, and comparing
      //     anything to undefined is an error. That fires on every profile
      //     written before the `role` field existed, which is every real one.
      //   - `request.resource.data.wardNo is int` alone — fine, but it lets a
      //     client set `wardNo` to 0 or a negative number.
      //
      // So each block validates the RESULTING document, not the delta:
      // "after this write, is the field either absent or a legal value?"
      //
      // Validating the delta instead — "was it touched, and if so is the new
      // value legal?" — looks equivalent and is not. Guarding it with
      // `!resource.data.keys().hasAll([...])` (skip the check when the field was
      // not there before) lets the very first role assignment through
      // unvalidated, because a profile written before the `role` field existed
      // has none. Every real profile is in that state. Checking the result
      // instead has no such hole and reads shorter.
      //
      // The rule this all comes down to, and the one worth remembering:
      // **Firestore rules `&&` and `||` do not short-circuit.** Both operands
      // are always evaluated, so a guard on one side of `||` does not protect
      // the other side from a type error. Every read of a possibly-absent
      // field below goes through `.get(field, default)`.
      allow update: if canManageAccounts()
                    && resource != null
                    && userId != request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['role', 'wardNo'])
                    // After this write, `wardNo` is either absent, null (an
                    // unrestricted role — `visibleWards` reads null as "no
                    // restriction", not "broken profile"), or a positive ward.
                    // `0` and negatives are rejected.
                    //
                    // `data.get(field, default)` rather than `data.field` is
                    // required here, not stylistic. Reading an absent field
                    // yields `undefined`, and ANY use of an undefined value is
                    // a rules error — including the `||` and `&&` branches
                    // guarded by a `keys().hasAll()` check on the line above,
                    // because **rules `&&` and `||` do not short-circuit**. Both
                    // sides of every operator are evaluated. `get` supplies the
                    // default so the comparison always has a real value to work
                    // with, and a role that was never set validates as null,
                    // which fails the `in` check exactly as it should.
                    && (request.resource.data.get('wardNo', null) == null
                        || (request.resource.data.get('wardNo', null) is int
                            && request.resource.data.get('wardNo', null) > 0))
                    // After this write, `role` is either absent or one of the
                    // four. It can never be nulled out or set to something
                    // invented, whatever the previous value was.
                    && request.resource.data.get('role', null) in
                         ['karykarta', 'admin', 'superAdmin', 'developer'];

      // Deleting an account is an admin action. Self-deletion stays available
      // because the Auth record outlives the document otherwise, and the
      // `userId != request.auth.uid` guard keeps the two paths from overlapping.
      allow delete: if canManageAccounts() && userId != request.auth.uid;

      // ----- fieldwork overlay (sync) ------------------------------------
      //
      // Everything a user edits about a voter, mirrored from the local
      // overlay (`lib/roll/overlay.ts`) by `lib/roll/sync.ts` so the same
      // account sees its edits on every device. PRIVATE by design: a doc
      // lives under the editor's own `users/{uid}`, so a karykarta's
      // fieldwork never leaks into anyone else's roll and no cross-user
      // query shape exists to write rules for.
      //
      // The base `voters` collection stays read-only — this is the only
      // path a client may store voter data through, and it is an overlay,
      // never a roll row (plan-voters.md §4, "never mutate the base roll").
      //
      // `hasOnly` is the security boundary here: the political-profiling
      // banlist (`party`, `support`, …) is enforced by omission — a write
      // carrying `support` is rejected as an unknown key rather than stored
      // because it slipped past a denylist. The key list below must mirror
      // `PUSHED_KEYS` in `lib/roll/sync.ts` plus `wardNo`/`updatedAt`/
      // `updatedBy`; `rules-tests/firestore.test.ts` pins both directions.
      match /voterEdits/{voterId} {
        // Own overlay only — `list` included, because the pull reads the
        // whole collection in one query.
        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(
               ['name', 'fatherOrHusbandName', 'houseNo', 'age', 'gender',
                'locality', 'phone', 'jati', 'location', 'photoUrl',
                'photoPublicId', 'voted', 'leaning', 'leaningNote', 'note',
                'wardNo', 'updatedAt', 'updatedBy'])
          // The three bookkeeping fields every pushed doc always carries —
          // their absence means the writer bypassed `pushEdits`.
          && request.resource.data.keys().hasAll(['wardNo', 'updatedAt', 'updatedBy'])
          && request.resource.data.wardNo is int
          && request.resource.data.wardNo > 0
          && (request.resource.data.updatedAt is int
              || request.resource.data.updatedAt is float)
          && text(request.resource.data.updatedBy, 1, 128)
          // Enum fields validated on the RESULTING doc via `get(field,
          // default)` — rules `&&` does not short-circuit, so reading an
          // absent field directly would be an evaluation error, not a deny.
          // The defaults ('') are members of each list on purpose: an absent
          // optional field passes, a typo (`voted: 'maybe'`) does not.
          && request.resource.data.get('gender', '') in
               ['', 'male', 'female', 'other']
          && request.resource.data.get('voted', '') in
               ['', 'unknown', 'voted', 'notVoted']
          && request.resource.data.get('leaning', '') in
               ['', 'unknown', 'right', 'centerRight', 'center',
                'centerLeft', 'left']
          && (request.resource.data.keys().hasAny(['age'])
              ? request.resource.data.age is int
              : true)
          // No political profiling keys reach this collection either —
          // `hasOnly` already rejects them; this says why, out loud.
          && noPoliticalFields(request.resource.data);

        // Deleting = "reset this device's/this account's edit", allowed for
        // the owner of the overlay (Settings → reset local edits can mirror a
        // clear to the account copy later; today the client only reads here).
        allow delete: if isOwner(userId);
      }
    }

    // ----- campaign -------------------------------------------------------

    match /campaigns/{campaignId} {
      allow read: if signedIn();

      allow create, update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data,
            ['name', 'candidateName', 'constituencyName', 'electionDate',
             'tagline', 'startDate', 'updatedAt'])
        && text(request.resource.data.name, 1, 120)
        && text(request.resource.data.candidateName, 0, 120)
        && text(request.resource.data.constituencyName, 0, 120)
        && nullableMillis(request.resource.data.electionDate)
        && nullableMillis(request.resource.data.startDate)
        && text(request.resource.data.tagline, 0, 200)
        && (request.resource.data.updatedAt == null
            || request.resource.data.updatedAt is timestamp);

      // The campaign document is the campaign.
      allow delete: if false;
    }

    // ----- geography ------------------------------------------------------
    //
    // Two kinds of ward document share this path:
    //
    //   wards/{1..13}      the imported roll, from scripts/seed-roll.mjs
    //   wards/ward-<slug>  campaign geography, from scripts/seed.mjs
    //
    // Both are seeded data and both are denied to client writes below.

    match /constituencies/{docId} {
      allow read: if signedIn();
      allow create, update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data, ['name', 'code'])
        && text(request.resource.data.name, 1, 120)
        && text(request.resource.data.code, 0, 40);
      allow delete: if canEditCampaign();
    }

    match /wards/{docId} {
      // Ward metadata is not ward-scoped. A karykarta has to see the ward
      // selector to know which ward is theirs, and 13 rows of delimitation text
      // is not a disclosure worth gating.
      allow read: if canReadVoters();

      // Client writes denied: every ward document is seeded data. This is what
      // makes `wardNo` trustworthy — a client cannot add a ward, so it also
      // cannot invent one to widen its own scope.
      allow create, update, delete: if false;
    }

    match /areas/{docId} {
      allow read: if canReadVoters();
      allow create, update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data, ['name', 'wardId', 'constituencyId'])
        && text(request.resource.data.name, 1, 120)
        && text(request.resource.data.wardId, 1, 128)
        && text(request.resource.data.constituencyId, 1, 128);
      allow delete: if canEditCampaign();
    }

    match /booths/{docId} {
      allow read: if canReadVoters();
      allow create, update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data,
            ['number', 'name', 'address', 'areaId', 'wardId', 'constituencyId',
             'estimatedVoters', 'coordinatorId'])
        && request.resource.data.number is int
        && request.resource.data.number > 0
        && text(request.resource.data.name, 1, 120)
        && text(request.resource.data.address, 0, 240)
        && text(request.resource.data.areaId, 1, 128)
        && text(request.resource.data.wardId, 1, 128)
        && text(request.resource.data.constituencyId, 1, 128)
        && request.resource.data.estimatedVoters is int
        && request.resource.data.estimatedVoters >= 0
        && text(request.resource.data.coordinatorId, 0, 128);
      allow delete: if canEditCampaign();
    }

    /**
     * `contactFinalize` in lib/roles.ts — super admin + developer.
     *
     * Deliberately its own helper rather than reusing `canManageAccounts`
     * inline: the predicate is the same rank today, but writing voter-phone
     * finalization in terms of *account management* is how a future reader
     * ends up widening one and not the other.
     */
    function canFinalizeContact() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && callerProfile().data.role in ['superAdmin', 'developer'];
    }

    // ----- voter roll -----------------------------------------------------
    //
    // `voters/{w{ward}-{serial}}`, seeded by scripts/seed-roll.mjs from the
    // CSVs `EXTRACTION.md` documents. See the note on `canReadVoter` for what a
    // karykarta asking for the whole collection gets.

    match /voters/{docId} {
      allow read: if canReadVoter(resource.data);

      // Read-only, unconditionally. The imported roll is the reference copy of
      // an official document; a typo in the app must not be able to corrupt it,
      // and no amount of client-side care is worth that guarantee being
      // enforced only by convention.
      //
      // User edits go to the overlay (`lib/roll/overlay.ts`), which is local
      // today. When sync lands it writes to its own collection with its own
      // rule block, and this one stays as it is.
      allow create, update, delete: if false;
    }

    // ----- shared voter phone numbers ------------------------------------
    //
    // The roll carries no phone numbers (plan-voters.md §4). An account's own
    // overlay number stayed in that account's private `voterEdits`, which meant
    // a karykarta's number and a super admin's number could never appear
    // together on one voter. This collection is the shared layer:
    //
    //   voterPhones/{voterId}                    the number in use (super admin's
    //                                            choice — who chose it, when)
    //   voterPhones/{voterId}/proposals/{uid}    one account's proposed number
    //
    // One proposal document per account, **keyed by the proposer's uid**, which
    // makes "you may write only your own entry" a path check (`isOwner`) rather
    // than a map-diff puzzle inside one document.
    //
    // Reads reuse `canReadVoter` — every document here carries `wardNo`, so a
    // karykarta's list is scoped per returned row exactly like the roll itself.
    // The `resource == null` branch exists because a GET of a not-yet-existing
    // document still evaluates the rule, and without it the editor of a voter
    // nobody has proposed a number for would get PERMISSION_DENIED instead of
    // "no numbers yet". That branch carries no ward membership: there is no
    // document on that path, so the only thing it can reveal is that a doc id
    // does not exist — a fact already known from the roll row itself.

    match /voterPhones/{voterId} {
      allow read: if (resource == null && canReadVoters())
                  || (resource != null && canReadVoter(resource.data));

      // Finalizing (and clearing) is `contactFinalize`: super admin +
      // developer, mirrored by `lib/roles.ts`. The whole document is written
      // each time (create and update share this rule), so `exactKeys` holds on
      // the RESULT — a partial merge that missed a key would be rejected.
      allow create, update: if canFinalizeContact()
        && exactKeys(request.resource.data,
             ['wardNo', 'finalPhone', 'finalizedBy', 'finalizedName', 'finalizedAt'])
        && request.resource.data.wardNo is int
        && request.resource.data.wardNo > 0
        // The shared board may only speak about a REAL roll row, at that row's
        // own ward — otherwise any id could be pre-planted with numbers from
        // another ward. `get()` on `voters` bypasses that path's access rules
        // (rules reads are not permission-checked), and a voterId that is not
        // in the roll at all errors here, which denies it — the client only
        // ever passes ids from a loaded roll, so that error is unreachable
        // through the app.
        && get(/databases/$(database)/documents/voters/$(voterId)).data.wardNo
             == request.resource.data.wardNo
        // `''` is the cleared state; anything else is a real number in the
        // same shape the proposals use.
        && request.resource.data.finalPhone.matches('^$|^[+]?[0-9]{6,15}$')
        && text(request.resource.data.finalPhone, 0, 20)
        && text(request.resource.data.finalizedBy, 0, 128)
        && text(request.resource.data.finalizedName, 0, 160)
        && (request.resource.data.finalizedAt == null
            || request.resource.data.finalizedAt is int
            || request.resource.data.finalizedAt is float)
        && noPoliticalFields(request.resource.data);

      allow delete: if canFinalizeContact();

      match /proposals/{proposerId} {
        allow read: if (resource == null && canReadVoters())
                    || (resource != null && canReadVoter(resource.data));

        // Proposing is `voterEdit` — every role that can read the roll may add
        // a number — but only onto your own document (`isOwner(proposerId)`)
        // and only inside your own ward: a karykarta writing ward 9 would be
        // smuggling data into a ward they cannot read back, and the ward check
        // on `wardNo` is what rules enforce that a UI toggle cannot.
        allow create, update: if canReadVoters()
          && isOwner(proposerId)
          && exactKeys(request.resource.data,
               ['phone', 'authorName', 'wardNo', 'updatedAt'])
          && request.resource.data.phone.matches('^[+]?[0-9]{6,15}$')
          && text(request.resource.data.authorName, 1, 160)
          && request.resource.data.wardNo is int
          && request.resource.data.wardNo > 0
          // Tied to the roll row itself, as on the parent above: a proposal
          // exists for a real voter, filed at that voter's own ward.
          && get(/databases/$(database)/documents/voters/$(voterId)).data.wardNo
               == request.resource.data.wardNo
          && (canSeeAllWards()
              || (callerProfile().data.role == 'karykarta'
                  && callerProfile().data.wardNo == request.resource.data.wardNo))
          && requiredMillis(request.resource.data.updatedAt)
          && noPoliticalFields(request.resource.data);

        // Withdrawing your own proposal is a normal edit, not a privilege —
        // "this number was wrong" comes from the person who entered it far
        // more often than from anyone else.
        allow delete: if isOwner(proposerId);
      }
    }

    // ----- team -----------------------------------------------------------

    match /teamMembers/{docId} {
      allow read: if canReadVoters();
      allow create, update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data,
            ['name', 'phone', 'role', 'status', 'areaId', 'boothId'])
        && text(request.resource.data.name, 1, 120)
        && text(request.resource.data.phone, 0, 15)
        && request.resource.data.role in ['coordinator', 'worker']
        && request.resource.data.status in ['active', 'inactive']
        && text(request.resource.data.areaId, 0, 128)
        && text(request.resource.data.boothId, 0, 128);
      allow delete: if canEditCampaign();
    }

    // ----- field tasks ----------------------------------------------------

    match /tasks/{docId} {
      allow read: if canReadVoters();

      allow create: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data,
            ['title', 'description', 'assigneeId', 'areaId', 'boothId',
             'dueDate', 'status', 'report', 'createdBy', 'createdAt', 'updatedAt'])
        && text(request.resource.data.title, 1, 200)
        && text(request.resource.data.description, 0, 2000)
        && text(request.resource.data.assigneeId, 0, 128)
        && text(request.resource.data.areaId, 0, 128)
        && text(request.resource.data.boothId, 0, 128)
        && nullableMillis(request.resource.data.dueDate)
        && request.resource.data.status in ['pending', 'in_progress', 'completed', 'issue']
        && text(request.resource.data.report, 0, 2000)
        && text(request.resource.data.createdBy, 0, 128)
        // serverTimestamp() evaluates to request.time — no client backdating.
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data,
            ['title', 'description', 'assigneeId', 'areaId', 'boothId',
             'dueDate', 'status', 'report', 'createdBy', 'createdAt', 'updatedAt'])
        && text(request.resource.data.title, 1, 200)
        && text(request.resource.data.description, 0, 2000)
        && text(request.resource.data.assigneeId, 0, 128)
        && text(request.resource.data.areaId, 0, 128)
        && text(request.resource.data.boothId, 0, 128)
        && nullableMillis(request.resource.data.dueDate)
        && request.resource.data.status in ['pending', 'in_progress', 'completed', 'issue']
        && text(request.resource.data.report, 0, 2000)
        && text(request.resource.data.createdBy, 0, 128)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if canEditCampaign();
    }

    // ----- civic issues ---------------------------------------------------

    match /issues/{docId} {
      allow read: if canReadVoters();

      allow create: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data,
            ['category', 'title', 'description', 'areaId', 'photoUrl', 'status',
             'reportedBy', 'reportedAt', 'updatedAt'])
        && request.resource.data.category in
             ['road', 'water', 'electricity', 'drainage', 'streetlight', 'sanitation']
        && text(request.resource.data.title, 1, 200)
        && text(request.resource.data.description, 0, 2000)
        && text(request.resource.data.areaId, 1, 128)
        && text(request.resource.data.photoUrl, 0, 1024)
        && request.resource.data.status in ['open', 'in_progress', 'resolved']
        && text(request.resource.data.reportedBy, 0, 120)
        && request.resource.data.reportedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data,
            ['category', 'title', 'description', 'areaId', 'photoUrl', 'status',
             'reportedBy', 'reportedAt', 'updatedAt'])
        && request.resource.data.category in
             ['road', 'water', 'electricity', 'drainage', 'streetlight', 'sanitation']
        && text(request.resource.data.title, 1, 200)
        && text(request.resource.data.description, 0, 2000)
        && text(request.resource.data.areaId, 1, 128)
        && text(request.resource.data.photoUrl, 0, 1024)
        && request.resource.data.status in ['open', 'in_progress', 'resolved']
        && text(request.resource.data.reportedBy, 0, 120)
        && request.resource.data.reportedAt == resource.data.reportedAt;

      allow delete: if canEditCampaign();
    }

    // ----- calendar -------------------------------------------------------

    match /events/{docId} {
      allow read: if canReadVoters();
      allow create, update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data, ['title', 'type', 'startsAt', 'endsAt', 'location', 'description', 'createdAt'])
        && text(request.resource.data.title, 1, 200)
        && request.resource.data.type in ['meeting', 'training', 'public', 'deadline']
        && requiredMillis(request.resource.data.startsAt)
        && nullableMillis(request.resource.data.endsAt)
        && text(request.resource.data.location, 0, 200)
        && text(request.resource.data.description, 0, 2000)
        && (request.resource.data.createdAt == null
            || request.resource.data.createdAt is timestamp);
      allow delete: if canEditCampaign();
    }

    // ----- expenses -------------------------------------------------------

    match /expenses/{docId} {
      allow read: if canReadVoters();

      allow create: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data,
            ['date', 'category', 'amount', 'description', 'receiptUrl', 'status',
             'createdBy', 'createdAt'])
        && requiredMillis(request.resource.data.date)
        && request.resource.data.category in
             ['travel', 'fuel', 'materials', 'printing', 'food', 'venue', 'other']
        && (request.resource.data.amount is int || request.resource.data.amount is float)
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 100000000
        && text(request.resource.data.description, 0, 500)
        && text(request.resource.data.receiptUrl, 0, 1024)
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && text(request.resource.data.createdBy, 0, 128)
        && request.resource.data.createdAt == request.time;

      allow update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data,
            ['date', 'category', 'amount', 'description', 'receiptUrl', 'status',
             'createdBy', 'createdAt'])
        && requiredMillis(request.resource.data.date)
        && request.resource.data.category in
             ['travel', 'fuel', 'materials', 'printing', 'food', 'venue', 'other']
        && (request.resource.data.amount is int || request.resource.data.amount is float)
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 100000000
        && text(request.resource.data.description, 0, 500)
        && text(request.resource.data.receiptUrl, 0, 1024)
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && text(request.resource.data.createdBy, 0, 128)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if canEditCampaign();
    }

    // ----- compliance checklist ------------------------------------------

    match /compliance/{docId} {
      allow read: if canReadVoters();
      allow create, update: if canEditCampaign()
        && noPoliticalFields(request.resource.data)
        && exactKeys(request.resource.data, ['title', 'category', 'status', 'dueDate', 'notes', 'updatedAt'])
        && text(request.resource.data.title, 1, 200)
        && text(request.resource.data.category, 1, 80)
        && request.resource.data.status in ['done', 'pending', 'attention']
        && nullableMillis(request.resource.data.dueDate)
        && text(request.resource.data.notes, 0, 1000)
        && (request.resource.data.updatedAt == null
            || request.resource.data.updatedAt is timestamp);
      allow delete: if canEditCampaign();
    }

    // Deliberately no `match /{document=**}`. Anything not named above is
    // denied — the Firestore equivalent of leaving RLS on with no policy, and
    // the single most common way a Firebase project leaks.
  }
}