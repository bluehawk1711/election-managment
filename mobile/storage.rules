rules_version = '2';

// The uid in the path is load-bearing, exactly the way
// `(storage.foldername(name))[1] = auth.uid()::text` is in a Supabase storage
// policy. hooks/useAvatarUpload.ts writes to `avatars/${user.uid}/avatar.<ext>`
// for this reason and nothing else.
//
// One Storage-specific trap worth knowing: `write` means create + update +
// delete, and on a delete `request.resource` is null. So a rule shaped like
//
//     allow write: if isOwner(userId) && request.resource.size < N;
//
// silently denies every delete — null has no `.size`. The methods are split out
// below so each one says what it actually means.

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /avatars/{userId}/{fileName} {
      // Owner-only, like `/files` below.
      //
      // This used to be `if true`, on the reasoning that an avatar is
      // innocuous and shows up next to a name. In this app it is not: these are
      // the faces of named people attached to a named constituency, and a
      // world-readable path means the whole roster can be pulled by anyone who
      // can guess the bucket name — no token, no app, no rate limit.
      //
      // It used to be argued that other team members need to see each other's
      // faces. Nothing does: `grep` for an `AvatarImage` sourced from anyone
      // but `profile.photoURL` finds only Settings and onboarding, both of
      // which show the signed-in user's own picture. If a roster avatar is ever
      // added, widen this deliberately then — with the rule change and its
      // test in the same commit.
      //
      // Note that tightening this does NOT invalidate a download URL already in
      // the wild; rotate the object's download token in the console for that.
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      // Separate, because request.resource is null on a delete.
      allow delete: if isOwner(userId);
    }

    match /files/{userId}/{fileName} {
      // Private, unlike avatars: only the owner may read.
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024;

      allow delete: if isOwner(userId);
    }
  }
}
