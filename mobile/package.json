    "expo-image-picker": "~57.0.6",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.4",
    "expo-localization": "^57.0.2",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.3",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
