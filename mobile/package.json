{
  "name": "election-campaign",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:rules": "jest --config jest.rules.config.js",
    "seed": "node scripts/seed.mjs",
    "seed:roll": "node scripts/seed-roll.mjs",
    "verify:roll": "node scripts/verify-roll.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "roll:bundle": "node scripts/generate-ward-bundles.ts",
    "photos:maps": "node scripts/generate-photo-maps.mjs",
    "create:user": "node scripts/create-user.mjs",
    "check:account": "node scripts/check-account.mjs",
    "seed:rtdb": "node scripts/seed-rtdb.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:client": "node scripts/verify-client.mjs",
    "probe:owner": "node scripts/probe-owner-write.mjs",
    "grant:claims": "node scripts/grant-claims.mjs",
    "emulators": "firebase emulators:start",
    "emulators:seed": "firebase emulators:exec --only firestore \"node scripts/seed.mjs\"",
    "rules:test": "firebase emulators:exec --only firestore,storage \"npm run test:rules\"",
    "//deploy:rules": "The database rules are the live ones. Firestore is a read-only backup now: deploying its rules would only re-publish a file nothing enforces, so it is deliberately NOT in this list.",
    "deploy:rules": "firebase deploy --only database,storage",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy": "firebase deploy --only database,storage"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
