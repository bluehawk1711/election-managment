# npm install fails on this tree without it: vitest@5 peerOptional wants
# @types/node ^22 || >=24 while the project pins ^20 (a pre-existing,
# working pairing — pnpm, the primary installer here, auto-installs peers
# and never complained). Pin the flag so `npm ci` / Vercel's npm path
# resolves the same tree pnpm does instead of aborting the build.
legacy-peer-deps=true
